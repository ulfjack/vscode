"""Bazel workspace for parity-diffing vscode's npm build against a Bazel build.

Deliberately minimal for now: one custom rule (ts_program) drives the whole-
project TS compile; no external Bazel modules (rules_nodejs, rules_ts, etc.).
Node is resolved from the host PATH via use_default_shell_env because the sandbox
already has `nodejs` installed for the npm-side instrumentation runs.
"""

module(name = "vscode", version = "0.0.0")

# Electron binary distribution -- fetched via http_archive so the user doesn't
# need npm to bootstrap. Version pinned to what package.json requests.
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# Electron's node headers -- needed by node-gyp to compile native modules
# against Electron's node ABI (Electron 42 uses node 22.x internally, so
# headers built for stock node 22 won't cover Electron's added V8/blink
# symbols). Distributed only from electronjs.org; the GitHub release for
# v42.2.0 doesn't include the headers tarball.
http_archive(
    name = "electron_headers",
    url = "https://electronjs.org/headers/v42.2.0/node-v42.2.0-headers.tar.gz",
    integrity = "sha256-0VUz+8wqnbAuXSml+p7vQ22fIiqj9gn56HiDz+5X0to=",
    strip_prefix = "node_headers",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(["**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
""",
)

http_archive(
    name = "electron_linux_x64",
    url = "https://github.com/electron/electron/releases/download/v42.2.0/electron-v42.2.0-linux-x64.zip",
    integrity = "sha256-nK7rFdraN8s6LYC/D1iZ0XXbAmpN7xFWCJC9LxloSQk=",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(["**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "electron_binary",
    srcs = ["electron"],
    visibility = ["//visibility:public"],
)
""",
)

